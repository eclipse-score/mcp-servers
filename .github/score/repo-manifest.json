{
  "version": 1,
  "repository": {
    "name": "mcp-servers",
    "language": "python",
    "visibility": "public",
    "tags": ["context-attention", "mcp", "apm", "python"]
  },
  "bootstrap": {
    "contract_version": "v0.1.0"
  },
  "execution": {
    "build": { "command": "uv sync" },
    "test": { "command": "uv run pytest" },
    "lint": { "command": "uv run ruff check ." },
    "typecheck": { "command": "uv run pyright" }
  },
  "mcp": {
    "server_name": "score-context-tools",
    "tools": ["search"]
  }
}
